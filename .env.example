# Copy this file to .env.local and fill in your values.

# Company details shown on the website
COMPANY_NAME="TourFlow Travels"
COMPANY_PHONE="+233 24 000 0000"
COMPANY_EMAIL="hello@example.com"

# Public URL of the site (used for payment callbacks)
APP_URL="http://localhost:3000"

# Admin login (change this before going live!)
ADMIN_PASSWORD="admin123"
SESSION_SECRET="change-me-to-a-long-random-string"

# Paystack (mobile money + card). Leave empty to use DEMO payments.
# Get keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""

# Arkesel SMS (optional). Leave empty and messages are only logged in the admin.
ARKESEL_API_KEY=""
SMS_SENDER_ID="TourFlow"

# WhatsApp number for the chat button (defaults to COMPANY_PHONE)
COMPANY_WHATSAPP=""
