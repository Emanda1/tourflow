# ---------------------------------------------------------------
# TourFlow server settings. Copy to .env.local (or set these in
# your hosting dashboard). Never commit the real file to GitHub.
# ---------------------------------------------------------------

# Public address of the website. Must be https:// in production.
APP_URL="http://localhost:3000"

# One-time code needed to create the first owner account in production
# (at /admin/setup). Use 12+ random characters; remove it after setup.
SETUP_CODE=""

# REQUIRED in production: how to find the visitor's real IP (for rate limits and the log).
# Behind Render/Railway/Nginx/Caddy: TRUST_PROXY="true" (and TRUST_PROXY_HOPS = number of
# proxies in front of the app, usually 1). Behind Cloudflare: IP_HEADER="cf-connecting-ip".
TRUST_PROXY="false"
TRUST_PROXY_HOPS="1"
# IP_HEADER=""

# REQUIRED in production: where the database, uploads and backups are stored (a persistent disk).
# DATA_DIR="/var/data"
# Advanced: exact database file, or a different backups folder.
# DB_PATH=""
# BACKUP_DIR=""
# Set to "false" to turn off the automatic daily backup (not recommended).
# BACKUPS_ENABLED="true"
# Time zone used to show dates and times.
# APP_TIMEZONE="Africa/Accra"

# --- Payments (Paystack: mobile money + card) ---
# Get keys at https://dashboard.paystack.com/#/settings/developers
# Leave empty and online payment is off in production (staff record payments).
PAYSTACK_SECRET_KEY=""
# Development only: lets you test bookings with fake payments. Never "true" in production.
# ALLOW_DEMO_PAYMENTS="false"

# --- SMS (Arkesel, optional) ---
ARKESEL_API_KEY=""
SMS_SENDER_ID="TourFlow"

# --- Email receipts (any SMTP provider, optional) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Your Company <bookings@yourcompany.com>"

# --- Tuning (optional) ---
# Minutes an unpaid online booking holds seats before they are released.
BOOKING_HOLD_MINUTES="30"
# Max automatic SMS per day triggered by public website forms (anti-abuse).
PUBLIC_SMS_DAILY_CAP="50"
# How many daily backups to keep on the server.
BACKUP_KEEP="14"
# Staff are signed out after this many hours.
SESSION_HOURS="12"

# Company name, phone, logo and policies are set in Admin → Settings.
# These are only used until the owner fills those in:
COMPANY_NAME="TourFlow Travels"
COMPANY_PHONE="+233 24 000 0000"
COMPANY_EMAIL="hello@example.com"
# COMPANY_ADDRESS=""
# COMPANY_WHATSAPP=""
